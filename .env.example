# GEMINI_API_KEY: Required for Gemini AI explanations, recommendation drafting, and report summaries.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MAX_UPLOAD_MB: Maximum permitted traffic video upload size in megabytes (10-1024).
MAX_UPLOAD_MB="250"

# CV_SERVICE_URL: External Python FastAPI + OpenCV + YOLO/ByteTrack service URL (see /cv_worker).
# When unset or unreachable, ROADSHADOW honestly reports Real CV Analysis as Unavailable
# while still validating, storing, and playing uploaded videos safely without fabricating detections.
CV_SERVICE_URL=""

# CV_SERVICE_API_KEY: Optional Bearer token for authenticating requests to CV_SERVICE_URL.
CV_SERVICE_API_KEY=""

# CV_SERVICE_TIMEOUT_MS: Request timeout in milliseconds when forwarding uploaded video to CV_SERVICE_URL.
CV_SERVICE_TIMEOUT_MS="120000"

# CV_HEALTH_TIMEOUT_MS: Health-check probe timeout in milliseconds for CV_SERVICE_URL (accounts for Cloud Run cold starts).
CV_HEALTH_TIMEOUT_MS="5000"

# CV_MAX_RETRIES: Number of automatic transient retries (0-3) on network/502/503/504/429 responses from CV_SERVICE_URL.
CV_MAX_RETRIES="2"

# SUMO_SERVICE_URL: Optional external SUMO (Simulation of Urban MObility) micro-simulation worker URL.
# Leave unset to use the built-in deterministic analytical junction modification estimator.
SUMO_SERVICE_URL=""
