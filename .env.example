# GEMINI_API_KEY: Required for server-side Gemini multimodal video analysis, AI explanations,
# recommendation drafting, and report summaries.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MAX_UPLOAD_MB: Maximum permitted traffic video upload size in megabytes (10-1024).
MAX_UPLOAD_MB="250"

# GEMINI_SEGMENT_TIMEOUT_MS: Server-side timeout in milliseconds per Gemini video analysis segment (15000-180000).
GEMINI_SEGMENT_TIMEOUT_MS="45000"

# SUMO_SERVICE_URL: Optional external SUMO (Simulation of Urban MObility) micro-simulation worker URL.
# Leave unset to use the built-in deterministic analytical junction modification estimator.
SUMO_SERVICE_URL=""
