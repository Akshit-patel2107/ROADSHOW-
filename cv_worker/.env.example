# ROADSHADOW 2.0 — External Python CV Worker Configuration

# HTTP port (Google Cloud Run automatically sets PORT=8080)
PORT="8080"

# Shared Bearer API key (strongly recommended in production).
# Must match CV_SERVICE_API_KEY configured in the ROADSHADOW Node backend.
CV_SERVICE_API_KEY=""

# Ultralytics YOLO weights path or model name (pre-cached at /app/weights/yolov8n.pt in Docker image)
YOLO_MODEL_PATH="yolov8n.pt"

# Inference device: "auto", "cpu", or "cuda:0"
YOLO_DEVICE="auto"

# Tracker configuration bundled with Ultralytics ("bytetrack.yaml" or "botsort.yaml")
CV_TRACKER_CONFIG="bytetrack.yaml"

# Frame sampling rate (frames per second analyzed) and upper frame cap per video
CV_SAMPLE_FPS="4.0"
CV_MAX_FRAMES="360"

# Minimum YOLO object detection confidence threshold (0.10 - 0.90)
CV_CONF_THRESHOLD="0.30"

# Maximum upload size accepted on /api/v1/analyze-upload and /api/v1/analyze (MB)
CV_MAX_UPLOAD_MB="250"

# Load YOLO model weights during FastAPI startup so first /health & inference requests are fast
CV_PRELOAD_MODEL="true"

# Logging verbosity (INFO, WARNING, ERROR)
LOG_LEVEL="INFO"
